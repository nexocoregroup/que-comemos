node_modules/
www/
*.apk
.DS_Store
Thumbs.db

# Caché local de Android Studio: no es contenido del proyecto.
.idea/caches/

# Claves en archivos de entorno. Hoy no hay ninguna: la app no lee `.env` en
# ninguna parte —lo único que usa del entorno es `PORT`, en `server.js`, que no
# es un secreto—. La regla se queda de todas formas, porque el día que alguien
# escriba una clave ahí para probar algo, un `git add .` la publicaría en un
# repositorio que es público.
.env
.env.*

# La clave de firma de Play Store y sus contraseñas. Quien las tenga puede
# publicar actualizaciones a tu nombre, y Google no deja cambiarlas una vez
# publicada la primera versión: si se filtran, no hay forma de revocarlas.
android/keystore.properties
*.jks
*.keystore
